/*
 * FastOMA configuration for the Shin 2021 benchmark: a copy of
 * peo-fastoma/nextflow.config with the work dir under
 * $ROOT/complex_Shin2021/fastoma. The image cache is the PEO one,
 * read only.
 */
singularity {
    cacheDir = '/mnt/project/FjellheimLab/martpali/' +
        'AnnualPerennial/peo-fastoma/singularity_cache'
    runOptions = '-B /work:/work -B /mnt/project:/mnt/project ' +
        '-B /net/fs-2/scale:/net/fs-2/scale -B /mnt/SCRATCH:/mnt/SCRATCH'
}

workDir = '/mnt/project/FjellheimLab/martpali/rcomplex-testrun/' +
    'complex_Shin2021/fastoma/work'

executor {
    name            = 'slurm'
    queueSize       = 100
    submitRateLimit = '30/1min'
    pollInterval    = '30 sec'
    exitReadTimeout = '300 sec'
    queueStatInterval = '1 min'
}

process {
    queue          = 'orion'
    clusterOptions = '--account=nmbu --qos=normal'

    // task I/O on node-local scratch ($TMPDIR = /work/users/martpali)
    scratch        = true
    stageInMode    = 'copy'
    stageOutMode   = 'move'

    // project group on everything a task writes (quota is per group)
    beforeScript = '''
        module load singularity
        umask 002
        chgrp fjellheimlab . 2>/dev/null || true
        chmod g+s . 2>/dev/null || true
    '''

    afterScript = '''
        chgrp -R fjellheimlab . 2>/dev/null || true
        chmod -R g+rwX . 2>/dev/null || true
    '''

    errorStrategy = {
        task.exitStatus in [137, 140, 143, 104, 134, 139] ? 'retry' : 'finish'
    }
    maxRetries    = 2
    cache         = 'lenient'
}

timeline { enabled = true; overwrite = true }
report { enabled = true; overwrite = true }
trace { enabled = true; overwrite = true }
dag { enabled = true; overwrite = true }
